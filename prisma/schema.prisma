generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Staff {
  id               String   @id @default(cuid())
  name             String
  username         String   @unique
  email            String   @default("")
  passwordHash     String   @db.VarChar(255)
  isAdmin          Boolean  @default(false)
  pagePermissions  Json
  sessionTokenHash String?  @db.VarChar(255)
  sessionExpiresAt DateTime?
  sessions         StaffSession[]
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model StaffSession {
  id        String   @id @default(cuid())
  staffId   String
  tokenHash String   @unique @db.VarChar(255)
  expiresAt DateTime
  staff     Staff    @relation(fields: [staffId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([staffId])
  @@index([expiresAt])
}

model Client {
  id        String   @id @default(cuid())
  name      String
  docType   String   @default("DNI")
  identity  String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @db.Text
  comment   String   @db.Text
  level     String   @default("VIP")
  devices   Device[]
  repairs   Repair[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([phone])
}

model Device {
  id           String   @id @default(cuid())
  clientId     String
  type         String   @default("Altro")
  brand        String   @default("")
  model        String   @default("")
  imei         String   @default("")
  serialNumber String   @default("")
  color        String   @default("")
  notes        String   @db.Text
  fingerprint  String   @db.VarChar(64)
  client       Client   @relation(fields: [clientId], references: [id], onDelete: Cascade)
  repairs      Repair[]
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([clientId, fingerprint])
  @@index([clientId])
  @@index([imei])
  @@index([serialNumber])
}

model Brand {
  id        String   @id @default(cuid())
  name      String   @unique
  sortOrder Int      @default(0)
  models    Model[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Model {
  id        String   @id @default(cuid())
  brandId   String
  name      String
  sortOrder Int      @default(0)
  brand     Brand    @relation(fields: [brandId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([brandId])
}

model Service {
  id          String   @id @default(cuid())
  defaultName String   @db.Text
  category    String   @default("")
  zh          String   @db.Text
  es          String   @db.Text
  price       Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Supplier {
  id        String   @id @default(cuid())
  name      String
  vatNumber String   @default("")
  taxCode   String   @default("")
  email     String   @default("")
  phone     String   @default("")
  address   String   @db.Text
  website   String   @default("")
  notes     String   @db.Text
  active    Boolean  @default(true)
  parts     Part[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([name])
  @@index([vatNumber])
  @@index([active])
}

model Part {
  id          String   @id @default(cuid())
  defaultName String   @db.Text
  category    String   @default("")
  zh          String   @db.Text
  es          String   @db.Text
  price       Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  sku         String?  @unique @db.VarChar(64)
  barcode     String?  @unique @db.VarChar(128)
  supplierId  String?
  cost        Decimal  @default(0) @db.Decimal(12, 2)
  stockQty    Decimal  @default(0) @db.Decimal(12, 3)
  minStock    Decimal  @default(0) @db.Decimal(12, 3)
  location    String   @default("")
  active      Boolean  @default(true)
  supplier    Supplier? @relation(fields: [supplierId], references: [id], onDelete: SetNull)
  movements   StockMovement[]
  repairParts RepairPart[]
  quoteItems  QuoteItem[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([supplierId])
  @@index([category])
  @@index([active])
  @@index([stockQty])
}

model Technician {
  id        String   @id @default(cuid())
  name      String   @unique
  phone     String   @default("")
  email     String   @default("")
  color     String   @default("#16a34a")
  active    Boolean  @default(true)
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AttributeGroup {
  id         String      @id @default(cuid())
  name       String      @unique
  attributes Attribute[]
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
}

model Attribute {
  id          String         @id @default(cuid())
  groupId     String
  defaultName String
  zh          String         @default("")
  es          String         @default("")
  sortOrder   Int            @default(0)
  group       AttributeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  @@index([groupId])
}

model Repair {
  id                  String       @id @default(cuid())
  ticket              String       @unique
  clientId            String
  deviceId            String?
  brand               String       @default("")
  model               String       @default("")
  properties          String       @db.Text
  imei                String       @default("")
  issue               String       @db.Text
  internalNote        String       @db.Text
  passwordType        String       @default("")
  passwordText        String       @default("")
  passwordPattern     Json
  status              String       @default("预定")
  repairTime          String       @default("")
  warrantyStart       String       @default("")
  technicianId        String       @default("")
  technicianName      String       @default("")
  budget              Decimal      @default(0) @db.Decimal(12, 2)
  deposit             Decimal      @default(0) @db.Decimal(12, 2)
  paymentMethod       String       @default("none")
  discountAmount      Decimal      @default(0) @db.Decimal(12, 2)
  costAmount          Decimal      @default(0) @db.Decimal(12, 2)
  finalAmount         Decimal      @default(0) @db.Decimal(12, 2)
  finalCostAmount     Decimal      @default(0) @db.Decimal(12, 2)
  finalMargin         Decimal      @default(0) @db.Decimal(12, 2)
  readyAt             DateTime?
  deliveredAt         DateTime?
  warrantyUntil       DateTime?
  frontPhoto          String       @db.LongText
  backPhoto           String       @db.LongText
  signatureDataUrl    String       @db.LongText
  signedAt            String       @default("")
  publicToken         String       @unique @default(cuid())
  orderType           String       @default("repair")
  sourceRepairId      String       @default("")
  warrantyReason      String       @db.Text
  warrantyDiagnosis   String       @db.Text
  warrantyResolution  String       @db.Text
  warrantyChargeable  Boolean      @default(false)
  statusHistory       Json
  notificationLog     Json
  searchText          String       @db.Text
  ticketSort          BigInt       @default(0)
  client              Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  device              Device?      @relation(fields: [deviceId], references: [id], onDelete: SetNull)
  diagnosis           Diagnosis?
  quotes              Quote[]
  items               RepairItem[]
  payments            Payment[]
  repairParts         RepairPart[]
  stockMovements      StockMovement[]
  finalTests          RepairTest[]
  delivery            DeliveryRecord?
  notifications       Notification[]
  createdAt           DateTime     @default(now())
  updatedAt           DateTime     @updatedAt

  @@index([clientId])
  @@index([deviceId])
  @@index([orderType])
  @@index([sourceRepairId])
  @@index([status])
  @@index([repairTime])
  @@index([readyAt])
  @@index([deliveredAt])
  @@index([warrantyUntil])
  @@index([createdAt])
  @@index([ticketSort])
  @@fulltext([searchText])
}

model Diagnosis {
  id              String   @id @default(cuid())
  repairId        String   @unique
  status          String   @default("DRAFT")
  technicianId    String   @default("")
  technicianName  String   @default("")
  findings        String   @db.Text
  rootCause       String   @db.Text
  proposedWork    String   @db.Text
  partsNeeded     String   @db.Text
  testsPerformed  String   @db.Text
  riskNotes       String   @db.Text
  customerSummary String   @db.Text
  createdBy       String   @default("")
  completedAt     DateTime?
  repair          Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([status])
  @@index([technicianId])
}

model Quote {
  id               String      @id @default(cuid())
  repairId         String
  version          Int
  status           String      @default("DRAFT")
  publicToken      String      @unique @default(cuid())
  title            String      @default("")
  customerMessage  String      @db.Text
  internalNote     String      @db.Text
  subtotal         Decimal     @default(0) @db.Decimal(12, 2)
  discountAmount   Decimal     @default(0) @db.Decimal(12, 2)
  total            Decimal     @default(0) @db.Decimal(12, 2)
  estimatedDays    Int?
  validUntil       DateTime?
  sentAt           DateTime?
  respondedAt      DateTime?
  customerResponse String      @default("")
  customerNote     String      @db.Text
  createdBy        String      @default("")
  supersededAt     DateTime?
  repair           Repair      @relation(fields: [repairId], references: [id], onDelete: Cascade)
  items            QuoteItem[]
  createdAt        DateTime    @default(now())
  updatedAt        DateTime    @updatedAt

  @@unique([repairId, version])
  @@index([repairId])
  @@index([status])
  @@index([validUntil])
}

model QuoteItem {
  id          String   @id @default(cuid())
  quoteId     String
  partId      String?
  type        String   @default("service")
  description String   @db.Text
  qty         Decimal  @default(1) @db.Decimal(12, 3)
  unitPrice   Decimal  @default(0) @db.Decimal(12, 2)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  lineTotal   Decimal  @default(0) @db.Decimal(12, 2)
  lineCost    Decimal  @default(0) @db.Decimal(12, 2)
  sortOrder   Int      @default(0)
  quote       Quote    @relation(fields: [quoteId], references: [id], onDelete: Cascade)
  part        Part?    @relation(fields: [partId], references: [id], onDelete: SetNull)
  repairParts RepairPart[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([quoteId])
  @@index([partId])
  @@index([type])
}

model RepairPart {
  id               String    @id @default(cuid())
  repairId         String
  partId           String
  quoteItemId      String?
  status           String    @default("REQUESTED")
  qtyRequested     Decimal   @default(1) @db.Decimal(12, 3)
  qtyReserved      Decimal   @default(0) @db.Decimal(12, 3)
  qtyUsed          Decimal   @default(0) @db.Decimal(12, 3)
  unitCostSnapshot Decimal   @default(0) @db.Decimal(12, 2)
  orderReference   String    @default("")
  expectedAt       DateTime?
  receivedAt       DateTime?
  notes            String    @db.Text
  repair           Repair    @relation(fields: [repairId], references: [id], onDelete: Cascade)
  part             Part      @relation(fields: [partId], references: [id], onDelete: Restrict)
  quoteItem        QuoteItem? @relation(fields: [quoteItemId], references: [id], onDelete: SetNull)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([repairId])
  @@index([partId])
  @@index([quoteItemId])
  @@index([status])
  @@index([expectedAt])
}

model StockMovement {
  id          String   @id @default(cuid())
  partId      String
  repairId    String?
  type        String
  quantity    Decimal  @db.Decimal(12, 3)
  stockBefore Decimal  @db.Decimal(12, 3)
  stockAfter  Decimal  @db.Decimal(12, 3)
  unitCost    Decimal  @default(0) @db.Decimal(12, 2)
  reference   String   @default("")
  note        String   @db.Text
  createdBy   String   @default("")
  happenedAt  DateTime @default(now())
  part        Part     @relation(fields: [partId], references: [id], onDelete: Restrict)
  repair      Repair?  @relation(fields: [repairId], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now())

  @@index([partId])
  @@index([repairId])
  @@index([type])
  @@index([happenedAt])
}

model RepairTest {
  id             String   @id @default(cuid())
  repairId       String
  status         String   @default("DRAFT")
  checklist      Json
  notes          String   @db.Text
  technicianId   String   @default("")
  technicianName String   @default("")
  createdBy      String   @default("")
  completedAt    DateTime?
  repair         Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  @@index([repairId])
  @@index([status])
  @@index([completedAt])
}

model DeliveryRecord {
  id                String   @id @default(cuid())
  repairId          String   @unique
  handedTo          String   @default("")
  note              String   @db.Text
  settlementMode    String   @default("PAID")
  amountDue         Decimal  @default(0) @db.Decimal(12, 2)
  amountPaid        Decimal  @default(0) @db.Decimal(12, 2)
  balanceAtDelivery Decimal  @default(0) @db.Decimal(12, 2)
  warrantyMonths    Int      @default(0)
  warrantyUntil     DateTime?
  deliveredAt       DateTime @default(now())
  createdBy         String   @default("")
  repair            Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([deliveredAt])
  @@index([settlementMode])
}

model Notification {
  id            String   @id @default(cuid())
  repairId      String
  event         String
  channel       String
  status        String   @default("QUEUED")
  provider      String   @default("")
  recipient     String
  subject       String   @default("")
  body          String   @db.Text
  externalId    String   @default("")
  attempts      Int      @default(0)
  lastError     String   @db.Text
  scheduledAt   DateTime @default(now())
  sentAt        DateTime?
  lastAttemptAt DateTime?
  dedupeKey     String   @unique @db.VarChar(191)
  repair        Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([repairId])
  @@index([event])
  @@index([channel])
  @@index([status])
  @@index([scheduledAt])
  @@index([createdAt])
}

model RepairItem {
  id        String   @id @default(cuid())
  repairId  String
  name      String   @db.Text
  qty       Decimal  @default(1) @db.Decimal(12, 3)
  price     Decimal  @default(0) @db.Decimal(12, 2)
  cost      Decimal  @default(0) @db.Decimal(12, 2)
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repairId])
}

model Payment {
  id        String   @id @default(cuid())
  repairId  String
  amount    Decimal  @default(0) @db.Decimal(12, 2)
  method    String   @default("cash")
  note      String   @default("")
  paidAt    DateTime @default(now())
  createdBy String   @default("")
  repair    Repair   @relation(fields: [repairId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([repairId])
  @@index([paidAt])
  @@index([method])
}

model Setting {
  id        String   @id @default("main")
  value     Json
  updatedAt DateTime @updatedAt
}

model BackupSnapshot {
  id        String   @id @default(cuid())
  kind      String   @default("manual")
  reason    String   @default("")
  data      Json
  counts    Json
  createdBy String   @default("")
  createdAt DateTime @default(now())

  @@index([createdAt])
  @@index([kind])
}
