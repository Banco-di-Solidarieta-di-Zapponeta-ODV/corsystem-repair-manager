# Database MySQL / MariaDB
DATABASE_URL="mysql://repairnote:repairnote@127.0.0.1:3308/repairnote"

# Accesso amministratore iniziale
REPAIRNOTE_ADMIN_USERNAME="admin"
REPAIRNOTE_ADMIN_PASSWORD="change-me"
REPAIRNOTE_COOKIE_SECURE=false

# URL pubblico del gestionale, usato nei link inviati ai clienti
CORSYSTEM_PUBLIC_URL="https://repair.corsystem.it"

# Invio automatico dopo gli eventi del gestionale
NOTIFICATIONS_AUTO_SEND=true

# Email via Resend
NOTIFICATIONS_EMAIL_ENABLED=false
RESEND_API_KEY=""
RESEND_FROM="CorSystem <assistenza@example.it>"

# WhatsApp via Meta Cloud API
NOTIFICATIONS_WHATSAPP_ENABLED=false
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
# Impostare esplicitamente la versione Graph API supportata dall'account Meta
META_GRAPH_API_VERSION=""
WHATSAPP_TEMPLATE_LANGUAGE="it"
# Per notifiche avviate dall'azienda usare template Meta approvati.
# Ogni template configurato deve accettare 3 parametri BODY: nome cliente, ticket, testo messaggio.
WHATSAPP_TEMPLATE_INTAKE_CREATED=""
WHATSAPP_TEMPLATE_QUOTE_SENT=""
WHATSAPP_TEMPLATE_QUOTE_APPROVED=""
WHATSAPP_TEMPLATE_QUOTE_REJECTED=""
WHATSAPP_TEMPLATE_WAITING_PART=""
WHATSAPP_TEMPLATE_READY=""
WHATSAPP_TEMPLATE_DELIVERED=""
# Abilitare solo quando è consentito inviare testo libero nella conversazione WhatsApp corrente.
WHATSAPP_ALLOW_SESSION_TEXT=false

# SMS via Twilio
NOTIFICATIONS_SMS_ENABLED=false
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
# Usare Messaging Service SID oppure un numero mittente Twilio.
TWILIO_MESSAGING_SERVICE_SID=""
TWILIO_FROM=""
